# ============================================================
# .env.example  –  Gerçek değerleri .env dosyasına kopyalayın.
# .env asla Git'e commit EDİLMEMELİDİR.
# ============================================================

# PostgreSQL
POSTGRES_DB=postgre_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Uygulama DB bağlantısı (docker-compose için)
DB_USERNAME=postgres
DB_PASSWORD=change-me

# JWT (minimum 256-bit / 32 karakter)
JWT_SECRET=change-me-with-a-secure-random-256-bit-key

# Redis (isteğe bağlı, prod'da gerekli)
REDIS_HOST=redis
REDIS_PORT=6379

# Cloudflare R2 / S3
STORAGE_ENDPOINT=https://change-me.r2.cloudflarestorage.com
STORAGE_BUCKET=randevu-dev
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
STORAGE_PUBLIC_URL=https://cdn.change-me.com

# Netgsm SMS
NETGSM_USERNAME=change-me
NETGSM_PASSWORD=change-me
NETGSM_HEADER=RANDEVU
